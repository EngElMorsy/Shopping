  "components": {
    "schemas": {
      "CreateEmployeeDto": {
        "required": [
          "city",
          "country",
          "fristLineAddress",
          "postcode",
          "title"
        ],
        "type": "object",
        "properties": {
          "title": {
            "maxLength": 45,
            "minLength": 1,
            "type": "string"
          },
          "fristLineAddress": {
            "maxLength": 40,
            "minLength": 1,
            "type": "string"
