          }
        },
        "additionalProperties": false
      },
      "RegisterUserDto": {
        "required": [
          "confirmPassword",
          "email",
          "fullname",
          "password"
        ],
        "type": "object",
        "properties": {
          "fullname": {
            "maxLength": 25,
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string",
            "format": "email"
